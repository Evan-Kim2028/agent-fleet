*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
# Local secrets — never commit API keys. Live smoke tests load from .env.
.env
.env.*
*.egg
.DS_Store
.coverage
htmlcov/
.worktrees/
.agent-fleet-state.json
.codegraph/
# Per-run transcripts and per-PR ownership notes. The runs dir captured
# gate-tiers/docs-fleet-index impl output to main; both are machine-local
# state that changes on every dispatch and must never be committed.
.agent-fleet/runs/
.agent-fleet/pr/
# Un-expanded $HOME: a shell that takes %h/~ literally wrote a gh API cache
# dump here, headers and all, and an auto-commit staged it.
/%h/
/~/


# Runtime junk / local experiments (never commit)
.tmp*
*.tmp
*.log
dispatch-*.log
.dispatch*.log
efficiency-trail.tsv
*.tsv.bak

# Per-target-repo configs and code stay local — agent-fleet is standalone.
# Live targets (silphcoanalytics, etc.) are not committed here; see examples/
# for committed templates.
targets/
