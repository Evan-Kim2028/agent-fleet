{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FindingsReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "line", "claim", "repro", "testable"],
        "properties": {
          "id": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 0},
          "claim": {"type": "string"},
          "repro": {"type": "string"},
          "testable": {"type": "boolean"}
        }
      }
    }
  }
}
