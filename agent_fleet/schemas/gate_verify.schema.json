{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerifyReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "REJECTED",
        "UNTESTABLE"
      ]
    },
    "test_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
